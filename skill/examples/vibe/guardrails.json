{
  "maxDepth": 10,
  "maxComponents": 60,
  "forbidNesting": [
    [
      "Card",
      "Card"
    ],
    [
      "Button",
      "Button"
    ]
  ],
  "requireProps": {
    "Button": [
      "action"
    ],
    "TextField": [
      "label"
    ]
  },
  "preferTable": {
    "component": "Table",
    "minItems": 7
  },
  "banned": [],
  "limits": [
    {
      "component": "Button",
      "where": {
        "variant": "primary"
      },
      "max": 1,
      "per": "section"
    }
  ],
  "sectionBoundaries": [
    "Card",
    "Tabs"
  ],
  "requireBinding": {
    "props": {
      "Table": [
        "rows"
      ]
    },
    "flagCopiedData": true
  }
}
